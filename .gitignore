# Maven
target/

# Vaadin auto-generated frontend bootstrap files (regenerated by `mvn` on every build via
# vaadin:prepare-frontend / vaadin:build-frontend — never hand-edited, and env/version-specific
# hashed filenames here would otherwise churn on every dev's machine)
src/main/frontend/generated/

# Desktop packaging output (see package-exe.ps1)
dist/
dist_v2/

# H2 database files
data/

# IDE
.idea/
*.iml
.vscode/
.classpath
.factorypath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env

# Claude Code
.claude/
